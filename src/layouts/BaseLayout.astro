---
import '@fontsource-variable/ibm-plex-sans';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description, noindex = false, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F5F7FA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>

<script>
  const toast = document.querySelector<HTMLElement>('#toast');
  document.addEventListener('samepage:toast', (event) => {
    if (!toast || !(event instanceof CustomEvent)) return;
    toast.textContent = event.detail;
    toast.classList.add('is-visible');
    window.setTimeout(() => toast.classList.remove('is-visible'), 2200);
  });
</script>
