---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="New questionnaire — SamePage" description="Create a SamePage questionnaire prototype." noindex>
  <AppShell active="new">
    <header class="builder-header">
      <a href={`${base}dashboard/`} class="builder-header__back">← Questionnaires</a>
      <div class="builder-steps" aria-label="Progress">
        <span class="is-active" data-indicator="1"><b>1</b> Document</span>
        <i></i>
        <span data-indicator="2"><b>2</b> Questions</span>
        <i></i>
        <span data-indicator="3"><b>3</b> Share</span>
      </div>
      <span class="builder-header__save">Demo · changes stay in this browser</span>
    </header>

    <div class="duplicate-notice" id="duplicate-notice" hidden>
      <strong>Question set copied.</strong> Add the new recipient and document reference. No AI analysis will be used.
    </div>

    <section class="builder-stage is-active" data-stage="1" aria-labelledby="stage-one-title">
      <div class="builder-intro"><p class="eyebrow">Step 1 of 3</p><h1 id="stage-one-title">What should your client understand?</h1><p>Add the agreement and identify the recipient. The original file is read for this step only and is never stored.</p></div>
      <form class="builder-form" id="document-form">
        <div class="upload-zone" id="upload-zone">
          <input type="file" id="file-input" accept=".pdf,.docx" />
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 5h14l8 8v29H14z"/><path d="M28 5v9h8M19 27h10m-5-5v10"/></svg>
          <div><strong id="upload-title">Drop a PDF or DOCX here</strong><p id="upload-copy">or choose a file · maximum 30 pages</p></div>
          <button class="button button--secondary" type="button" id="choose-file">Choose file</button>
          <small>Prototype note: the demo uses a sample document and never uploads your selection.</small>
        </div>

        <div class="form-grid">
          <div class="field field--full"><span class="field__label">Recipient type</span><div class="segmented"><label><input type="radio" name="recipient-type" value="professional" checked /><span>Professional client</span></label><label><input type="radio" name="recipient-type" value="private" /><span>Private individual</span></label></div></div>
          <div class="field"><label for="client-name">Client name</label><input id="client-name" name="client-name" value="Northwind Studio" required /></div>
          <div class="field"><label for="document-id">Document reference</label><input id="document-id" name="document-id" value="SP-2026-041" required /><p class="field__hint">Your own number or recognizable name.</p></div>
          <div class="field field--full"><label for="document-name">Document name</label><input id="document-name" name="document-name" value="Website redesign agreement" required /><p class="field__hint">Used to group insights across recurring document types.</p></div>
        </div>

        <div class="privacy-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3m2 0H5v10h14z" /></svg><div><strong>The document itself is not stored.</strong><p>In the real product, extracted text is processed transiently to draft questions. Only the questions you approve are saved.</p></div></div>

        <div class="builder-actions"><a href={`${base}dashboard/`} class="button button--secondary">Cancel</a><button class="button button--primary" type="submit" id="generate-button">Generate draft questions <span aria-hidden="true">→</span></button></div>
      </form>
    </section>

    <section class="builder-stage" data-stage="loading" aria-live="polite">
      <div class="generating"><div class="generating__mark"><span></span></div><p class="eyebrow">Reading for ambiguity</p><h1>Drafting questions you can review.</h1><p>Checking scope, responsibilities, timing, approvals and assumptions…</p><div class="generating__line"><span></span></div></div>
    </section>

    <section class="builder-stage" data-stage="2" aria-labelledby="stage-two-title">
      <div class="questions-header">
        <div class="builder-intro"><p class="eyebrow">Step 2 of 3</p><h1 id="stage-two-title">Review every question.</h1><p>Nothing reaches your client until you approve it. Select the answer that matches your intended meaning.</p></div>
        <div class="questions-count"><strong id="question-count">5</strong><span>of 10 questions</span></div>
      </div>

      <div class="review-banner"><strong>Drafted from “Website redesign agreement”</strong><span>Check legal meaning and wording yourself. SamePage is not legal advice.</span></div>
      <div class="question-list" id="question-list"></div>
      <button class="add-question" id="add-question" type="button">+ Add your own question</button>
      <p class="question-limit" id="question-limit">Minimum 3 · maximum 10 questions</p>
      <div class="builder-actions"><button class="button button--secondary" type="button" data-go="1">← Back</button><button class="button button--primary" type="button" id="save-questionnaire">Save and create share link <span aria-hidden="true">→</span></button></div>
    </section>

    <section class="builder-stage" data-stage="3" aria-labelledby="stage-three-title">
      <div class="share-success">
        <div class="share-success__check" aria-hidden="true">✓</div>
        <p class="eyebrow">Ready to share</p>
        <h1 id="stage-three-title">Your questionnaire is live.</h1>
        <p>Send this private link to Northwind Studio. They can answer without creating an account.</p>
        <div class="share-link"><span id="share-url">theoneistari.github.io/samepage/check/demo</span><button type="button" id="copy-link">Copy link</button></div>
        <div class="share-details"><span><small>Document</small><strong>Website redesign agreement</strong></span><span><small>Reference</small><strong>SP-2026-041</strong></span><span><small>Questions</small><strong id="final-count">5</strong></span><span><small>Link expires</small><strong>30 days</strong></span></div>
        <div class="share-actions"><a class="button button--primary" href={`${base}check/demo/`}>Preview client experience</a><a class="button button--secondary" href={`${base}dashboard/`}>Return to dashboard</a></div>
        <p class="share-success__note">In the real product, links are random, revocable and version-locked. This public PoC uses one fixed demo link.</p>
      </div>
    </section>
  </AppShell>
</BaseLayout>

<style>
  .builder-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; margin-bottom: 50px; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
  .builder-header__back { color: var(--muted); font-size: .82rem; font-weight: 600; text-decoration: none; }
  .builder-header__back:hover { color: var(--ink); }
  .builder-header__save { justify-self: end; color: var(--muted); font-size: .72rem; }
  .builder-steps { display: flex; align-items: center; gap: 8px; }
  .builder-steps > span { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: .74rem; font-weight: 600; }
  .builder-steps b { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid var(--rule-strong); border-radius: 50%; font-size: .68rem; }
  .builder-steps i { width: 38px; height: 1px; background: var(--rule); }
  .builder-steps .is-active { color: var(--ink); }
  .builder-steps .is-active b { color: white; border-color: var(--action); background: var(--action); }
  .builder-steps .is-done b { color: var(--success); border-color: var(--success); background: var(--success-soft); }
  .duplicate-notice { max-width: 760px; margin: -24px auto 28px; padding: 14px 16px; color: #60401f; background: var(--alignment-soft); border: 1px solid #edc6a8; border-radius: 8px; font-size: .84rem; line-height: 1.5; }
  .builder-stage { display: none; }
  .builder-stage.is-active { display: block; animation: stage-in .28s ease both; }
  @keyframes stage-in { from { opacity: 0; transform: translateY(8px); } }
  .builder-intro { max-width: 680px; margin: 0 auto 36px; text-align: center; }
  .builder-intro h1, .generating h1, .share-success h1 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; letter-spacing: -.04em; font-weight: 570; }
  .builder-intro > p:last-child, .generating > p, .share-success > p { color: var(--muted); line-height: 1.6; }
  .builder-form { max-width: 760px; margin-inline: auto; }
  .upload-zone { position: relative; min-height: 230px; padding: 32px; border: 1px dashed #aeb7c4; border-radius: 12px; background: rgba(255,255,255,.62); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .upload-zone.has-file { border-style: solid; border-color: var(--success); background: var(--success-soft); }
  .upload-zone input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .upload-zone svg { width: 42px; height: 42px; margin-bottom: 12px; color: var(--action); }
  .upload-zone strong { font-size: 1.05rem; }
  .upload-zone p { margin: 5px 0 17px; color: var(--muted); font-size: .82rem; }
  .upload-zone small { margin-top: 16px; color: var(--muted); font-size: .7rem; }
  .form-grid { margin-top: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .field--full { grid-column: 1 / -1; }
  .segmented { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .segmented label { position: relative; }
  .segmented input { position: absolute; opacity: 0; pointer-events: none; }
  .segmented span { min-height: 44px; display: grid; place-items: center; padding: 8px; border: 1px solid var(--rule-strong); border-radius: 7px; background: white; font-size: .82rem; cursor: pointer; }
  .segmented input:checked + span { color: var(--action); border-color: var(--action); background: var(--action-soft); box-shadow: inset 0 0 0 1px var(--action); }
  .privacy-note { margin-top: 28px; padding: 17px; display: flex; gap: 13px; border-block: 1px solid var(--rule); }
  .privacy-note svg { flex: none; width: 22px; height: 22px; color: var(--success); }
  .privacy-note strong { font-size: .85rem; }
  .privacy-note p { margin: 4px 0 0; color: var(--muted); font-size: .79rem; line-height: 1.5; }
  .builder-actions { margin-top: 32px; display: flex; justify-content: space-between; gap: 12px; }
  .generating { min-height: 520px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .generating__mark { position: relative; width: 70px; height: 70px; margin-bottom: 30px; border: 1px solid var(--rule-strong); border-radius: 50%; }
  .generating__mark::before, .generating__mark::after { content: ""; position: absolute; top: 22px; width: 14px; height: 25px; border: 2px solid var(--action); }
  .generating__mark::before { left: 14px; border-right: 0; border-radius: 5px 0 0 5px; }
  .generating__mark::after { right: 14px; border-left: 0; border-radius: 0 5px 5px 0; }
  .generating__mark span { position: absolute; top: 34px; left: 28px; width: 14px; height: 2px; background: var(--alignment); animation: pulse 1s ease infinite alternate; }
  @keyframes pulse { to { transform: scaleX(.5); opacity: .5; } }
  .generating > p { margin: 12px 0 0; }
  .generating__line { width: 250px; height: 3px; margin-top: 34px; background: var(--rule); overflow: hidden; }
  .generating__line span { display: block; width: 45%; height: 100%; background: var(--action); animation: progress 1.2s ease-in-out infinite; }
  @keyframes progress { from { transform: translateX(-100%); } to { transform: translateX(240%); } }
  .questions-header { display: flex; align-items: end; justify-content: space-between; gap: 30px; max-width: 850px; margin: 0 auto 30px; }
  .questions-header .builder-intro { margin: 0; text-align: left; }
  .questions-count { text-align: right; white-space: nowrap; }
  .questions-count strong, .questions-count span { display: block; }
  .questions-count strong { font-size: 1.7rem; }
  .questions-count span { color: var(--muted); font-size: .72rem; }
  .review-banner { max-width: 850px; margin: 0 auto 16px; padding: 14px 16px; border: 1px solid var(--rule); background: white; display: flex; align-items: center; justify-content: space-between; gap: 24px; font-size: .78rem; }
  .review-banner span { color: var(--muted); }
  .question-list { max-width: 850px; margin-inline: auto; display: grid; gap: 14px; }
  .question-card { padding: 24px; border: 1px solid var(--rule); border-radius: 10px; background: white; }
  .question-card__top { display: flex; align-items: flex-start; gap: 14px; }
  .question-card__number { flex: none; display: grid; place-items: center; width: 27px; height: 27px; border: 1px solid var(--rule-strong); border-radius: 50%; color: var(--muted); font-size: .72rem; font-weight: 700; }
  .question-card__text { flex: 1; min-height: 42px; padding: 0 0 8px; border: 0; border-bottom: 1px solid transparent; border-radius: 0; color: var(--ink); background: transparent; font-size: 1rem; font-weight: 600; line-height: 1.45; resize: none; }
  .question-card__text:focus { outline: 0; border-bottom-color: var(--action); }
  .question-card__remove { border: 0; background: transparent; color: var(--muted); padding: 4px; cursor: pointer; }
  .question-card__remove:hover { color: #a93232; }
  .question-options { margin-top: 18px; padding-left: 41px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .question-options label { position: relative; }
  .question-options input { position: absolute; opacity: 0; }
  .question-options span { min-height: 44px; padding: 10px 12px; display: flex; align-items: center; gap: 9px; border: 1px solid var(--rule); border-radius: 7px; color: var(--muted); font-size: .8rem; cursor: pointer; }
  .question-options span::before { content: ""; flex: none; width: 14px; height: 14px; border: 1px solid var(--rule-strong); border-radius: 50%; }
  .question-options input:checked + span { color: var(--action); border-color: var(--action); background: var(--action-soft); }
  .question-options input:checked + span::before { border: 4px solid var(--action); }
  .question-card__meta { margin: 14px 0 0 41px; color: var(--muted); font-size: .7rem; }
  .add-question { display: block; width: min(100%, 850px); min-height: 50px; margin: 14px auto 0; border: 1px dashed var(--rule-strong); border-radius: 8px; background: transparent; color: var(--action); font-weight: 650; cursor: pointer; }
  .add-question:hover { background: var(--action-soft); }
  .question-limit { max-width: 850px; margin: 10px auto 0; color: var(--muted); font-size: .72rem; text-align: center; }
  [data-stage="2"] .builder-actions { max-width: 850px; margin-inline: auto; }
  .share-success { max-width: 760px; margin: 38px auto 0; text-align: center; }
  .share-success__check { display: grid; place-items: center; width: 58px; height: 58px; margin: 0 auto 24px; border-radius: 50%; color: white; background: var(--success); font-size: 1.5rem; }
  .share-success > p { max-width: 56ch; margin-inline: auto; }
  .share-link { margin: 28px 0 26px; padding: 9px 9px 9px 15px; border: 1px solid var(--rule-strong); border-radius: 8px; background: white; display: flex; align-items: center; gap: 14px; text-align: left; }
  .share-link span { min-width: 0; flex: 1; color: var(--action); font-size: .84rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .share-link button { min-height: 36px; padding: 0 12px; border: 0; border-radius: 6px; color: white; background: var(--action); font-weight: 650; cursor: pointer; }
  .share-details { display: grid; grid-template-columns: repeat(4,1fr); border-block: 1px solid var(--rule); }
  .share-details span { padding: 18px 10px; border-right: 1px solid var(--rule); }
  .share-details span:last-child { border: 0; }
  .share-details small, .share-details strong { display: block; }
  .share-details small { margin-bottom: 5px; color: var(--muted); font-size: .68rem; }
  .share-details strong { font-size: .79rem; }
  .share-actions { margin-top: 30px; display: flex; justify-content: center; gap: 10px; }
  .share-success__note { margin-top: 24px !important; font-size: .72rem; }
  @media (max-width: 760px) {
    .builder-header { grid-template-columns: 1fr; margin-bottom: 34px; }
    .builder-header__back, .builder-header__save { display: none; }
    .builder-steps { justify-content: center; }
    .builder-steps > span { font-size: 0; }
    .builder-steps b { font-size: .68rem; }
    .builder-intro { text-align: left; }
    .form-grid { grid-template-columns: 1fr; }
    .field--full { grid-column: auto; }
    .questions-header { align-items: flex-start; }
    .review-banner { align-items: flex-start; flex-direction: column; gap: 5px; }
    .question-card { padding: 18px 14px; }
    .question-options { padding-left: 0; grid-template-columns: 1fr; }
    .question-card__meta { margin-left: 0; }
    .share-details { grid-template-columns: 1fr 1fr; }
    .share-details span:nth-child(2) { border-right: 0; }
    .share-details span:nth-child(-n+2) { border-bottom: 1px solid var(--rule); }
    .share-actions, .builder-actions { flex-direction: column-reverse; }
    .share-actions .button, .builder-actions .button { width: 100%; }
  }
</style>

<script>
  type DemoQuestion = { text: string; options: string[]; answer: number; topic: string };

  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

  const starterQuestions: DemoQuestion[] = [
    { text: 'What counts as one revision round?', options: ['Feedback collected across the whole project', 'A separate round for every page'], answer: 0, topic: 'Scope' },
    { text: 'Who must provide final copy and images before design starts?', options: ['The client', 'The designer'], answer: 0, topic: 'Responsibility' },
    { text: 'When does the four-week delivery estimate begin?', options: ['When the agreement is signed', 'When all required content is received'], answer: 1, topic: 'Timing' },
    { text: 'What happens when feedback arrives after an approval?', options: ['It is included automatically', 'It may require a separate estimate'], answer: 1, topic: 'Changes' },
    { text: 'Which browser versions are included in testing?', options: ['Current major versions listed in the agreement', 'Every browser version still in use'], answer: 0, topic: 'Assumptions' },
  ];

  let questions = [...starterQuestions];
  const stages = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
  const indicators = [...document.querySelectorAll<HTMLElement>('[data-indicator]')];
  const fileInput = document.querySelector<HTMLInputElement>('#file-input');
  const chooseFile = document.querySelector<HTMLButtonElement>('#choose-file');
  const uploadZone = document.querySelector<HTMLElement>('#upload-zone');
  const uploadTitle = document.querySelector<HTMLElement>('#upload-title');
  const uploadCopy = document.querySelector<HTMLElement>('#upload-copy');
  const form = document.querySelector<HTMLFormElement>('#document-form');
  const list = document.querySelector<HTMLElement>('#question-list');
  const count = document.querySelector<HTMLElement>('#question-count');
  const finalCount = document.querySelector<HTMLElement>('#final-count');
  const addButton = document.querySelector<HTMLButtonElement>('#add-question');
  const saveButton = document.querySelector<HTMLButtonElement>('#save-questionnaire');
  const duplicateNotice = document.querySelector<HTMLElement>('#duplicate-notice');

  const showStage = (stage: string) => {
    stages.forEach((item) => item.classList.toggle('is-active', item.dataset.stage === stage));
    const numeric = Number(stage) || 1;
    indicators.forEach((item) => {
      const current = Number(item.dataset.indicator);
      item.classList.toggle('is-active', current === numeric);
      item.classList.toggle('is-done', current < numeric);
      const marker = item.querySelector('b');
      if (marker) marker.textContent = current < numeric ? '✓' : String(current);
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char] ?? char);

  const renderQuestions = () => {
    if (!list) return;
    list.innerHTML = questions.map((question, index) => `
      <article class="question-card" data-question="${index}">
        <div class="question-card__top">
          <span class="question-card__number">${index + 1}</span>
          <textarea class="question-card__text" rows="2" aria-label="Question ${index + 1}">${escapeHtml(question.text)}</textarea>
          <button class="question-card__remove" type="button" aria-label="Remove question ${index + 1}" ${questions.length <= 3 ? 'disabled' : ''}>×</button>
        </div>
        <div class="question-options">
          ${question.options.map((option, optionIndex) => `<label><input type="radio" name="answer-${index}" value="${optionIndex}" ${question.answer === optionIndex ? 'checked' : ''} /><span>${escapeHtml(option)}</span></label>`).join('')}
        </div>
        <p class="question-card__meta">${escapeHtml(question.topic)} · The selected answer reflects your intended meaning</p>
      </article>`).join('');
    if (count) count.textContent = String(questions.length);
    if (finalCount) finalCount.textContent = String(questions.length);
    if (addButton) addButton.disabled = questions.length >= 10;

    list.querySelectorAll<HTMLTextAreaElement>('.question-card__text').forEach((textarea, index) => {
      textarea.addEventListener('input', () => { questions[index].text = textarea.value; });
    });
    list.querySelectorAll<HTMLElement>('.question-card').forEach((card, index) => {
      card.querySelector<HTMLButtonElement>('.question-card__remove')?.addEventListener('click', () => {
        if (questions.length <= 3) return;
        questions.splice(index, 1); renderQuestions();
      });
      card.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((radio) => {
        radio.addEventListener('change', () => { questions[index].answer = Number(radio.value); });
      });
    });
  };

  chooseFile?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    uploadZone?.classList.add('has-file');
    if (uploadTitle) uploadTitle.textContent = file.name;
    if (uploadCopy) uploadCopy.textContent = `${Math.max(1, Math.round(file.size / 1024))} KB · ready for the prototype`;
    if (chooseFile) chooseFile.textContent = 'Choose another file';
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    showStage('loading');
    window.setTimeout(() => { renderQuestions(); showStage('2'); }, 1200);
  });

  document.querySelectorAll<HTMLElement>('[data-go]').forEach((button) => button.addEventListener('click', () => showStage(button.dataset.go ?? '1')));
  addButton?.addEventListener('click', () => {
    if (questions.length >= 10) return;
    questions.push({ text: 'Add a clear question about this agreement…', options: ['First answer', 'Second answer'], answer: 0, topic: 'Custom' });
    renderQuestions();
  });
  saveButton?.addEventListener('click', () => {
    if (questions.length < 3 || questions.some((q) => !q.text.trim())) return;
    showStage('3');
  });

  document.querySelector<HTMLButtonElement>('#copy-link')?.addEventListener('click', async (event) => {
    const url = `${window.location.origin}${base}check/demo/`;
    try { await navigator.clipboard.writeText(url); } catch { /* Clipboard can be unavailable on previews. */ }
    const button = event.currentTarget as HTMLButtonElement;
    button.textContent = 'Copied';
    document.dispatchEvent(new CustomEvent('samepage:toast', { detail: 'Share link copied' }));
  });

  if (new URLSearchParams(window.location.search).has('duplicate')) {
    if (duplicateNotice) duplicateNotice.hidden = false;
    const client = document.querySelector<HTMLInputElement>('#client-name');
    const reference = document.querySelector<HTMLInputElement>('#document-id');
    if (client) client.value = '';
    if (reference) reference.value = '';
  }
</script>
