---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="SamePage — Check what your client understood" description="Turn an agreement into a short client check and find mismatched expectations before work begins.">
  <SiteHeader />
  <main id="main">
    <section class="hero site-shell">
      <div class="hero__copy">
        <p class="eyebrow">For service businesses, before work begins</p>
        <h1>Know what your client thinks the agreement means.</h1>
        <p class="lede">SamePage turns an agreement into a short multiple-choice check. Your client answers through a private link; you see exactly which expectations do not match.</p>
        <div class="hero__actions">
          <a class="button button--primary" href={`${base}dashboard/`}>Open the product demo</a>
          <span>No signup · sample data</span>
        </div>
      </div>

      <div class="product-story" aria-label="How SamePage finds a misunderstanding">
        <div class="story-step">
          <span class="story-step__number">1</span>
          <div><small>Agreement says</small><p>“The project includes two revision rounds.”</p></div>
        </div>
        <div class="story-step">
          <span class="story-step__number">2</span>
          <div><small>Client is asked</small><p>What counts as one revision round?</p><span class="selected-answer">A separate round for every page</span></div>
        </div>
        <div class="story-result">
          <span aria-hidden="true">↔</span>
          <div><small>SamePage finds</small><strong>1 expectation to clarify before kickoff</strong></div>
        </div>
      </div>
    </section>

    <section class="workflow" id="how-it-works">
      <div class="site-shell">
        <div class="section-heading">
          <p class="eyebrow">How it works</p>
          <h2 class="headline">A check between sending the agreement and starting the work.</h2>
        </div>
        <ol class="workflow__steps">
          <li><span>01</span><div><h3>Create the check</h3><p>Upload an agreement. Review, edit or replace the 3–10 draft questions before anything is shared.</p></div></li>
          <li><span>02</span><div><h3>Your client answers</h3><p>They open one private link and answer without an account. The original document is not shown or stored.</p></div></li>
          <li><span>03</span><div><h3>Discuss only the differences</h3><p>SamePage compares their answers with your intended meaning and highlights what needs a conversation.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="focus">
      <div class="site-shell focus__grid">
        <div>
          <p class="eyebrow">Deliberately narrow</p>
          <h2 class="headline">It checks understanding. Nothing more.</h2>
          <p class="focus__copy">SamePage does not write, edit or sign agreements. It gives both sides a practical moment to catch different interpretations before they become expensive.</p>
        </div>
        <div class="scope-list">
          <div><span>Included</span><p>Question review, client answers, mismatch report and a timestamped answer trail.</p></div>
          <div><span>Not included</span><p>Contract drafting, legal advice, e-signatures, invoicing or project management.</p></div>
          <div><span>Privacy</span><p>The source document is processed transiently and not retained. Only approved questions and answers remain.</p></div>
        </div>
      </div>
    </section>

    <section class="pricing" id="pricing">
      <div class="site-shell pricing__grid">
        <div>
          <p class="eyebrow">Simple pricing</p>
          <h2 class="headline">Start manually. Add document analysis when it saves time.</h2>
        </div>
        <div class="plans">
          <div class="plan">
            <div><strong>Manual</strong><p>Create and share your own questions.</p></div>
            <span><b>€0</b> forever</span>
          </div>
          <div class="plan plan--pro">
            <div><strong>Pro</strong><p>50 AI-assisted document analyses per month.</p></div>
            <span><b>€19.99</b> / month</span>
          </div>
          <a class="button button--primary" href={`${base}dashboard/`}>Explore the full product flow</a>
        </div>
      </div>
    </section>
  </main>
  <footer class="footer"><div class="site-shell"><span>© 2026 SamePage</span><span>Check understanding before commitment.</span><a href="#main">Back to top ↑</a></div></footer>
</BaseLayout>

<style>
  .hero { min-height: 680px; padding-block: clamp(76px, 10vw, 128px); display: grid; grid-template-columns: 1fr .9fr; align-items: center; gap: clamp(52px, 9vw, 120px); }
  .hero__copy { max-width: 680px; }
  .hero h1 { max-width: 11ch; margin: 0; font-size: clamp(3rem, 6.2vw, 5.6rem); line-height: .98; letter-spacing: -.058em; font-weight: 560; text-wrap: balance; }
  .hero .lede { max-width: 58ch; margin: 27px 0 0; }
  .hero__actions { margin-top: 32px; display: flex; align-items: center; gap: 16px; }
  .hero__actions > span { color: var(--muted); font-size: .76rem; }

  .product-story { border: 1px solid var(--rule-strong); border-radius: 12px; background: white; box-shadow: var(--shadow); }
  .story-step { padding: 23px; display: grid; grid-template-columns: 28px 1fr; gap: 14px; border-bottom: 1px solid var(--rule); }
  .story-step__number { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--rule-strong); border-radius: 50%; color: var(--muted); font-size: .7rem; font-weight: 700; }
  .story-step small, .story-result small { display: block; margin-bottom: 6px; color: var(--muted); font-size: .69rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .story-step p { margin: 0; font-size: .94rem; line-height: 1.5; font-weight: 580; }
  .selected-answer { display: block; margin-top: 12px; padding: 10px 12px; border: 1px solid #edc6a8; border-radius: 6px; color: #7d390e; background: var(--alignment-soft); font-size: .82rem; }
  .story-result { padding: 20px 23px; display: flex; align-items: center; gap: 15px; background: #172033; color: white; border-radius: 0 0 11px 11px; }
  .story-result > span { color: #ffc18f; font-size: 1.3rem; }
  .story-result small { color: #aeb6c6; }
  .story-result strong { font-size: .9rem; line-height: 1.4; }

  .workflow { padding-block: clamp(80px, 10vw, 126px); border-block: 1px solid var(--rule); background: white; }
  .workflow .section-heading { max-width: 780px; }
  .workflow__steps { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule-strong); display: grid; grid-template-columns: repeat(3, 1fr); }
  .workflow__steps li { min-height: 230px; padding: 26px 30px 12px 0; border-right: 1px solid var(--rule); display: flex; flex-direction: column; justify-content: space-between; }
  .workflow__steps li + li { padding-left: 30px; }
  .workflow__steps li:last-child { border-right: 0; }
  .workflow__steps > li > span { color: var(--action); font-size: .75rem; font-weight: 750; letter-spacing: .08em; }
  .workflow__steps h3 { margin: 0 0 9px; font-size: 1.25rem; font-weight: 620; }
  .workflow__steps p { margin: 0; color: var(--muted); line-height: 1.6; }

  .focus { padding-block: clamp(82px, 11vw, 138px); background: var(--ink); color: white; }
  .focus__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(60px, 10vw, 130px); }
  .focus .eyebrow { color: #9fb2ff; }
  .focus__copy { max-width: 54ch; margin-top: 24px; color: #adb6c7; line-height: 1.7; }
  .scope-list { border-top: 1px solid rgba(255,255,255,.26); }
  .scope-list > div { padding: 24px 0; display: grid; grid-template-columns: 120px 1fr; gap: 28px; border-bottom: 1px solid rgba(255,255,255,.16); }
  .scope-list span { color: white; font-weight: 620; }
  .scope-list p { margin: 0; color: #adb6c7; line-height: 1.55; }

  .pricing { padding-block: clamp(82px, 10vw, 126px); }
  .pricing__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(60px, 10vw, 130px); align-items: start; }
  .plans { border-top: 1px solid var(--rule-strong); }
  .plan { min-height: 100px; padding: 22px 0; display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: center; border-bottom: 1px solid var(--rule); }
  .plan strong { font-size: 1.05rem; }
  .plan p { margin: 5px 0 0; color: var(--muted); font-size: .84rem; }
  .plan > span { color: var(--muted); font-size: .75rem; text-align: right; }
  .plan b { display: block; color: var(--ink); font-size: 1.25rem; }
  .plans > .button { margin-top: 24px; }

  .footer { background: white; border-top: 1px solid var(--rule); }
  .footer > div { min-height: 80px; display: flex; align-items: center; gap: 24px; color: var(--muted); font-size: .78rem; }
  .footer a { margin-left: auto; text-decoration: none; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .product-story { width: min(100%, 620px); }
    .focus__grid, .pricing__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .hero { padding-block: 64px 76px; gap: 46px; }
    .hero h1 { font-size: clamp(2.75rem, 14vw, 4rem); }
    .hero__actions { align-items: stretch; flex-direction: column; }
    .hero__actions > span { text-align: center; }
    .workflow__steps { grid-template-columns: 1fr; }
    .workflow__steps li, .workflow__steps li + li { min-height: 0; padding: 24px 0; border-right: 0; border-bottom: 1px solid var(--rule); gap: 32px; }
    .scope-list > div { grid-template-columns: 1fr; gap: 8px; }
    .footer > div { padding-block: 24px; flex-wrap: wrap; }
  }
</style>
