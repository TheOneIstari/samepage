---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Questionnaires — SamePage" description="SamePage company dashboard prototype." noindex>
  <AppShell active="dashboard">
    <header class="app-header">
      <div><h1 class="app-title">Questionnaires</h1><p class="app-subtitle">See where client expectations stand and what still needs a conversation.</p></div>
      <a class="button button--primary" href={`${base}new/`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        New questionnaire
      </a>
    </header>

    <section class="attention" aria-labelledby="attention-title">
      <div><p class="eyebrow">Needs your attention</p><h2 id="attention-title">Two clients have answers to align.</h2></div>
      <div class="attention__items">
        <a href={`${base}questionnaire/`}><span><strong>Northwind Studio</strong><small>Website redesign agreement</small></span><b>2 points</b><span aria-hidden="true">→</span></a>
        <a href={`${base}questionnaire/`}><span><strong>Orchid & Co.</strong><small>Monthly support agreement</small></span><b>1 point</b><span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="documents" aria-labelledby="all-title">
      <div class="documents__toolbar">
        <h2 id="all-title">All questionnaires</h2>
        <div class="documents__filters">
          <label><span class="sr-only">Search questionnaires</span><input id="search" type="search" placeholder="Search client or document" /></label>
          <label><span class="sr-only">Filter by status</span><select id="status-filter"><option value="all">All statuses</option><option value="alignment">Needs alignment</option><option value="complete">Aligned</option><option value="shared">Shared</option><option value="draft">Draft</option></select></label>
        </div>
      </div>
      <div class="document-table" role="table" aria-label="Questionnaires">
        <div class="document-table__head" role="row"><span>Document</span><span>Client</span><span>Status</span><span>Updated</span><span></span></div>
        <a class="document-row" role="row" href={`${base}questionnaire/`} data-status="alignment" data-search="website redesign agreement northwind studio sp-2026-041">
          <span><strong>Website redesign agreement</strong><small>SP-2026-041 · v1</small></span><span>Northwind Studio</span><span><i class="status status--review">2 points to align</i></span><time>Today</time><b aria-hidden="true">→</b>
        </a>
        <a class="document-row" role="row" href={`${base}questionnaire/`} data-status="complete" data-search="brand strategy proposal meridian coffee sp-2026-038">
          <span><strong>Brand strategy proposal</strong><small>SP-2026-038 · v1</small></span><span>Meridian Coffee</span><span><i class="status status--complete">Aligned</i></span><time>12 Nov</time><b aria-hidden="true">→</b>
        </a>
        <a class="document-row" role="row" href={`${base}questionnaire/`} data-status="shared" data-search="photography agreement atelier west sp-2026-036">
          <span><strong>Photography agreement</strong><small>SP-2026-036 · v2</small></span><span>Atelier West</span><span><i class="status status--shared">Shared</i></span><time>9 Nov</time><b aria-hidden="true">→</b>
        </a>
        <a class="document-row" role="row" href={`${base}questionnaire/`} data-status="alignment" data-search="monthly support agreement orchid co sp-2026-035">
          <span><strong>Monthly support agreement</strong><small>SP-2026-035 · v1</small></span><span>Orchid & Co.</span><span><i class="status status--review">1 point to align</i></span><time>8 Nov</time><b aria-hidden="true">→</b>
        </a>
        <a class="document-row" role="row" href={`${base}questionnaire/`} data-status="draft" data-search="consulting agreement blank sp-2026-042">
          <span><strong>Consulting agreement</strong><small>SP-2026-042 · v1</small></span><span>—</span><span><i class="status status--draft">Draft</i></span><time>6 Nov</time><b aria-hidden="true">→</b>
        </a>
        <p class="documents__empty" id="empty-state" hidden>No questionnaires match those filters.</p>
      </div>
    </section>

    <section class="insights" id="insights" aria-labelledby="insights-title">
      <div class="insights__intro"><p class="eyebrow">Document insight</p><h2 id="insights-title">Revision scope causes the most confusion.</h2><p>Across your website agreements, clients diverged most often on what counts as a revision round.</p></div>
      <div class="insights__chart" aria-label="Misunderstanding rate by topic">
        <div><span>Revision scope</span><i><b style="width: 42%"></b></i><strong>42%</strong></div>
        <div><span>Client responsibilities</span><i><b style="width: 27%"></b></i><strong>27%</strong></div>
        <div><span>Delivery timing</span><i><b style="width: 18%"></b></i><strong>18%</strong></div>
      </div>
    </section>
  </AppShell>
</BaseLayout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .attention { margin-bottom: 48px; padding: 28px 0; border-block: 1px solid var(--rule-strong); display: grid; grid-template-columns: minmax(220px,.7fr) 1.3fr; gap: 56px; }
  .attention .eyebrow { margin-bottom: 8px; color: var(--alignment); }
  .attention h2 { margin: 0; max-width: 15ch; font-size: 1.45rem; line-height: 1.2; letter-spacing: -.02em; font-weight: 570; }
  .attention__items { display: grid; }
  .attention__items a { display: grid; grid-template-columns: 1fr auto 20px; gap: 20px; align-items: center; min-height: 64px; color: inherit; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .attention__items a:first-child { border-top: 1px solid var(--rule); }
  .attention__items a:hover strong { color: var(--action); }
  .attention__items strong, .attention__items small { display: block; }
  .attention__items strong { font-size: .9rem; }
  .attention__items small { margin-top: 3px; color: var(--muted); font-size: .76rem; }
  .attention__items b { color: var(--alignment); font-size: .78rem; }
  .documents { margin-bottom: 68px; }
  .documents__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 16px; }
  .documents__toolbar h2 { margin: 0; font-size: 1.15rem; font-weight: 620; }
  .documents__filters { display: flex; gap: 8px; }
  .documents__filters input, .documents__filters select { min-height: 40px; border: 1px solid var(--rule-strong); border-radius: 7px; background: white; padding: 8px 11px; color: var(--ink); font-size: .8rem; }
  .documents__filters input { width: 230px; }
  .document-table { border-top: 1px solid var(--rule-strong); }
  .document-table__head, .document-row { display: grid; grid-template-columns: minmax(220px,1.4fr) minmax(130px,.8fr) minmax(150px,.8fr) 70px 22px; gap: 22px; align-items: center; }
  .document-table__head { min-height: 43px; color: var(--muted); font-size: .7rem; font-weight: 650; text-transform: uppercase; letter-spacing: .06em; }
  .document-row { min-height: 78px; border-top: 1px solid var(--rule); color: inherit; text-decoration: none; }
  .document-row:hover { background: rgba(255,255,255,.65); }
  .document-row strong, .document-row small { display: block; }
  .document-row strong { font-size: .88rem; }
  .document-row small { margin-top: 4px; color: var(--muted); font-size: .72rem; }
  .document-row > span:nth-child(2), .document-row time { color: var(--muted); font-size: .8rem; }
  .document-row i { font-style: normal; }
  .documents__empty { padding: 32px 0; color: var(--muted); text-align: center; }
  .insights { scroll-margin-top: 24px; padding-top: 56px; border-top: 1px solid var(--rule-strong); display: grid; grid-template-columns: .85fr 1.15fr; gap: 70px; }
  .insights h2 { margin: 0 0 12px; max-width: 14ch; font-size: 1.7rem; line-height: 1.15; letter-spacing: -.025em; font-weight: 570; }
  .insights__intro > p:last-child { max-width: 46ch; color: var(--muted); line-height: 1.55; }
  .insights__chart { padding-top: 12px; }
  .insights__chart > div { display: grid; grid-template-columns: 160px 1fr 42px; align-items: center; gap: 14px; min-height: 54px; border-bottom: 1px solid var(--rule); font-size: .82rem; }
  .insights__chart i { height: 7px; background: #e5e9ef; border-radius: 4px; overflow: hidden; }
  .insights__chart b { display: block; height: 100%; background: var(--action); border-radius: 4px; }
  .insights__chart strong { text-align: right; font-size: .78rem; }
  @media (max-width: 900px) {
    .document-table__head { display: none; }
    .document-row { grid-template-columns: 1fr auto; gap: 10px; padding: 16px 0; }
    .document-row > span:nth-child(2) { grid-column: 1; }
    .document-row > span:nth-child(3) { grid-column: 2; grid-row: 1 / span 2; }
    .document-row time, .document-row > b { display: none; }
  }
  @media (max-width: 680px) {
    .attention, .insights { grid-template-columns: 1fr; gap: 24px; }
    .attention h2 { max-width: none; }
    .documents__toolbar { align-items: stretch; flex-direction: column; }
    .documents__filters { flex-direction: column; }
    .documents__filters input, .documents__filters select { width: 100%; }
    .insights__chart > div { grid-template-columns: 120px 1fr 36px; }
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('#search');
  const status = document.querySelector<HTMLSelectElement>('#status-filter');
  const rows = [...document.querySelectorAll<HTMLElement>('.document-row')];
  const empty = document.querySelector<HTMLElement>('#empty-state');

  function applyFilters() {
    const query = search?.value.trim().toLowerCase() ?? '';
    const wantedStatus = status?.value ?? 'all';
    let visible = 0;
    rows.forEach((row) => {
      const matchesText = (row.dataset.search ?? '').includes(query);
      const matchesStatus = wantedStatus === 'all' || row.dataset.status === wantedStatus;
      row.hidden = !(matchesText && matchesStatus);
      if (!row.hidden) visible += 1;
    });
    if (empty) empty.hidden = visible > 0;
  }
  search?.addEventListener('input', applyFilters);
  status?.addEventListener('change', applyFilters);
</script>
